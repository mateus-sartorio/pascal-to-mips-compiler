{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Web Application (Launch)",
      "request": "launch",
      "mainClass": "webapp.WebApplication",
      "projectName": "pascal-to-mips-compiler",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Web Application (Attach)",
      "request": "attach",
      "hostName": "127.0.0.1",
      "port": 5005,
      "timeout": 30000,
      "projectName": "pascal-to-mips-compiler",
      "preLaunchTask": "Start Web Application (Debug Port)"
    }
  ]
}
